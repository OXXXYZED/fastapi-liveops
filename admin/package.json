{
  "name": "liveops-admin",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "gen:api": "cd ../server && PYTHONPATH=. uv run python ../scripts/dump_openapi.py > ../admin/openapi.json && cd ../admin && openapi-typescript openapi.json -o src/api/schema.d.ts",
    "e2e": "node e2e/smoke.mjs"
  },
  "dependencies": {
    "@tanstack/react-query": "5.59.16",
    "openapi-fetch": "0.13.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "6.27.0"
  },
  "devDependencies": {
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.3",
    "openapi-typescript": "7.4.2",
    "typescript": "5.6.3",
    "vite": "5.4.10"
  }
}
